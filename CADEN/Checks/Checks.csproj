<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="OrchestrationCases*.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Core/Core.csproj" />
    <Compile Include="../../cad-vision-game/Assets/Scripts/CADEN/Hosting/*.cs" Link="Hosting/%(Filename)%(Extension)" />
    <Compile Include="../Desktop/FileDiagnostics.cs" Link="FileDiagnostics.cs" />
    <Compile Include="../Desktop/FileTokenUsage.cs" Link="FileTokenUsage.cs" />
  </ItemGroup>
</Project>
